            "op": "read_template",
            "template": "room.cell:${cellId}.occupied"
          }
        },
        "missingCells": {
          "op": "filter",
          "items": {
            "op": "var",
            "name": "cells"
          },
          "as": "cellId",
          "where": {
            "op": "not",
            "value": {
              "op": "read_template",
              "template": "room.cell:${cellId}.occupied"
            }
          }
        },
        "complete": {
          "op": "eq",
          "left": {
            "op": "length",
            "value": {
              "op": "var",
              "name": "missingCells"
            }
          },
          "right": 0
        },
        "dieValues": {
          "op": "map",
          "items": {
            "op": "var",
            "name": "occupiedCells"
          },
          "as": "cellId",
          "value": {
            "op": "read_template",
            "template": "room.cell:${cellId}.dieValue"
          }
        },
        "modifier": {
          "op": "read",
          "path": "room.modifier"
        },
        "roomValue": {
          "op": "if",
          "condition": {
            "op": "var",
            "name": "complete"
          },
          "then": {
            "op": "add",
            "values": [
              {
                "op": "sum",
                "items": {
                  "op": "var",
                  "name": "dieValues"
                }
              },
              {
                "op": "var",
                "name": "modifier"
              }
            ]
          },
          "else": null
        },
        "energyCost": {
          "op": "read",
          "path": "room.energyCost"
        },
        "roomPhaseStatus": {
          "op": "if",
          "condition": {
            "op": "var",
            "name": "complete"
          },
          "then": "ready_but_not_resolved",
          "else": "setup_only_incomplete"
        }
      },
      "output": {
        "kind": "set_noticed_room_state",
        "fields": {
          "roomId": {
            "op": "var",
            "name": "roomId"
