    {
      "programId": "aa-descent-v1",
      "revision": 1,
      "sourceRuleIds": [
        "die_moves_same_column_ships",
        "aa_room"
      ],
      "trigger": {
        "qKind": "placement_movement",
        "relation": {
          "roomTypes": [
            "aa"
          ]
        }
      },
      "requiredReads": [
        "event.dieValue"
      ],
      "bindings": {
        "dieValue": {
          "op": "read",
          "path": "event.dieValue"
        },
        "reducedDescent": {
          "op": "subtract",
          "left": {
            "op": "var",
            "name": "dieValue"
          },
          "right": 1
        },
        "movementAmount": {
          "op": "max",
          "values": [
            0,
            {
              "op": "var",
              "name": "reducedDescent"
            }
          ]
        }
      },
      "output": {
        "kind": "set_movement_amount",
        "fields": {
          "amount": {
            "op": "var",
            "name": "movementAmount"
          }
        }
      }
    },
    {
