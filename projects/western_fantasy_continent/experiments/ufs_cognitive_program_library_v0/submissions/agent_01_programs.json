            "op": "var",
            "name": "roomType"
          },
          "occupiedCells": {
            "op": "var",
            "name": "occupiedCells"
          },
          "missingCells": {
            "op": "var",
            "name": "missingCells"
          },
          "complete": {
            "op": "var",
            "name": "complete"
          },
          "roomValue": null,
          "energyCost": {
            "op": "var",
            "name": "energyCost"
          },
          "roomPhaseStatus": "no_room_phase_output"
        }
      }
    },
    {
      "programId": "multi-room-completeness-v1",
