    {
      "programId": "spawn-empty-columns",
      "revision": 1,
      "sourceRuleIds": [
        "spawn_empty_columns_first"
      ],
      "trigger": {
        "qKind": "spawn_priority_empty",
        "relation": {}
      },
      "requiredReads": [
        "spawn.shipId",
        "sky.columnIds",
        "sky.column:${columnId}.shipIds",
        "sky.column:${columnId}.dropPointId"
      ],
      "bindings": {
        "shipId": {
          "op": "read",
          "path": "spawn.shipId"
        },
        "columnIds": {
          "op": "read",
          "path": "sky.columnIds"
        },
        "emptyColumnIds": {
          "op": "filter",
          "items": {
            "op": "var",
            "name": "columnIds"
          },
          "as": "columnId",
          "where": {
            "op": "eq",
            "left": {
              "op": "length",
              "value": {
                "op": "read_template",
                "template": "sky.column:${columnId}.shipIds"
              }
            },
            "right": 0
          }
        },
        "candidateDropPointIds": {
          "op": "map",
          "items": {
            "op": "var",
            "name": "emptyColumnIds"
          },
          "as": "columnId",
          "value": {
            "op": "read_template",
            "template": "sky.column:${columnId}.dropPointId"
          }
        },
        "hasChoice": {
          "op": "gte",
          "left": {
            "op": "length",
            "value": {
              "op": "var",
              "name": "candidateDropPointIds"
            }
          },
          "right": 2
        }
      },
      "output": {
        "kind": "spawn_candidates",
        "fields": {
          "shipId": {
            "op": "var",
            "name": "shipId"
          },
          "candidateDropPointIds": {
            "op": "var",
            "name": "candidateDropPointIds"
          },
          "stopKind": {
            "op": "if",
            "condition": {
              "op": "var",
              "name": "hasChoice"
            },
            "then": "choice",
            "else": "automatic"
          }
        }
      }
    },
    {
