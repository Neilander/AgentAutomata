    {
      "programId": "mothership-phase-descent",
      "revision": 1,
      "sourceRuleIds": [
        "mothership_descends_each_round"
      ],
      "trigger": {
        "qKind": "mothership_phase_start",
        "relation": {}
      },
      "requiredReads": [
        "mothership.row",
        "sky.row:${nextRow}.shipIds"
      ],
      "bindings": {
        "fromRow": {
          "op": "read",
          "path": "mothership.row"
        },
        "nextRow": {
          "op": "add",
          "values": [
            {
              "op": "var",
              "name": "fromRow"
            },
            1
          ]
        },
        "collectedShipIds": {
          "op": "read_template",
          "template": "sky.row:${nextRow}.shipIds"
        }
      },
      "output": {
        "kind": "mothership_phase_descent",
        "fields": {
          "fromRow": {
            "op": "var",
            "name": "fromRow"
          },
          "toRow": {
            "op": "var",
            "name": "nextRow"
          },
          "collectedShipIds": {
            "op": "var",
            "name": "collectedShipIds"
          },
          "stopKind": "automatic"
        }
      }
    },
