  "programs": [
    {
      "programId": "research-completion-before-destruction",
      "revision": 1,
      "sourceRuleIds": [
        "win_by_research_before_destruction"
      ],
      "trigger": {
        "qKind": "research_completion",
        "relation": {}
      },
      "requiredReads": [
        "research.complete",
        "city.destroyed"
      ],
      "bindings": {
        "researchComplete": {
          "op": "read",
          "path": "research.complete"
        },
        "cityDestroyed": {
          "op": "read",
          "path": "city.destroyed"
        },
        "isWin": {
          "op": "and",
          "values": [
            {
              "op": "var",
              "name": "researchComplete"
            },
            {
              "op": "not",
              "value": {
                "op": "var",
                "name": "cityDestroyed"
              }
            }
          ]
        }
      },
      "output": {
        "kind": "terminal_check",
        "fields": {
          "terminal": {
            "op": "var",
            "name": "isWin"
          },
          "result": {
            "op": "if",
            "condition": {
              "op": "var",
              "name": "isWin"
            },
            "then": "win",
            "else": "ongoing"
          },
          "reason": "research_completed_before_city_destruction",
          "stopKind": {
            "op": "if",
            "condition": {
              "op": "var",
              "name": "isWin"
            },
            "then": "complete",
            "else": "automatic"
          }
        }
      }
    },
