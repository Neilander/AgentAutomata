          },
          "as": "dropPointId",
          "value": {
            "op": "read_template",
            "template": "spawn.dropPoint:${dropPointId}.distanceFromHighestShip"
          }
        },
        "maximumDistance": {
          "op": "max",
          "values": {
            "op": "var",
            "name": "distances"
          }
        },
        "candidateDropPointIds": {
          "op": "filter",
          "items": {
            "op": "var",
            "name": "availableDropPointIds"
          },
          "as": "dropPointId",
          "where": {
            "op": "eq",
            "left": {
              "op": "read_template",
              "template": "spawn.dropPoint:${dropPointId}.distanceFromHighestShip"
            },
            "right": {
              "op": "var",
              "name": "maximumDistance"
            }
          }
        },
        "hasChoice": {
          "op": "gte",
          "left": {
            "op": "length",
            "value": {
              "op": "var",
              "name": "candidateDropPointIds"
            }
          },
          "right": 2
        }
      },
      "output": {
        "kind": "spawn_candidates",
        "fields": {
          "shipId": {
            "op": "var",
            "name": "shipId"
          },
          "candidateDropPointIds": {
            "op": "var",
            "name": "candidateDropPointIds"
          },
          "stopKind": {
            "op": "if",
            "condition": {
              "op": "var",
              "name": "hasChoice"
            },
            "then": "choice",
            "else": "automatic"
          }
        }
      }
